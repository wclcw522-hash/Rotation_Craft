          "fallback": { "type": "minecraft:model", "model": "rotation_craft:item/flail_bare_iron" }
        }
      }
    ],
    "fallback": {
      "type": "minecraft:select",
      "property": "minecraft:component",
      "component": "rotation_craft:flail_casting",
      "cases": [
        {
          "when": true,
          "model": { "type": "minecraft:model", "model": "rotation_craft:item/flail_string_only" }
        }
      ],
      "fallback": {
        "type": "minecraft:select",
        "property": "minecraft:component",
        "component": "rotation_craft:flail_key",
        "cases": [
