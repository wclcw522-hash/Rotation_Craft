              { "when": "dripstone_ball", "model": { "type": "minecraft:model", "model": "rotation_craft:item/flail_dripstone" } },
              { "when": "preserve_ball", "model": { "type": "minecraft:model", "model": "rotation_craft:item/flail_preserve" } },
              { "when": "talisman_ball", "model": { "type": "minecraft:model", "model": "rotation_craft:item/flail_talisman" } },
              { "when": "echo_ball", "model": { "type": "minecraft:model", "model": "rotation_craft:item/flail_echo" } }
