              { "when": "copper_ball", "model": { "type": "minecraft:model", "model": "rotation_craft:item/flail_copper" } },
              { "when": "hollow_copper_ball", "model": { "type": "minecraft:model", "model": "rotation_craft:item/flail_hollow_copper" } },
